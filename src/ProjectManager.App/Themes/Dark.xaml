<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 深色主题令牌。键集合与 Light.xaml 严格一致。 -->

    <SolidColorBrush x:Key="PmBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PmSurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PmSurfaceAltBrush" Color="#323232" />
    <SolidColorBrush x:Key="PmSurfaceHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PmBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="PmBorderStrongBrush" Color="#565656" />
    <SolidColorBrush x:Key="PmTextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="PmTextSecondaryBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="PmTextDisabledBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="PmAccentBrush" Color="#479EF5" />
    <SolidColorBrush x:Key="PmAccentHoverBrush" Color="#62ABF5" />
    <SolidColorBrush x:Key="PmAccentPressedBrush" Color="#2D7DD2" />
    <SolidColorBrush x:Key="PmAccentTextBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="PmAccentSubtleBrush" Color="#12344D" />
    <SolidColorBrush x:Key="PmDangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="PmDangerSubtleBrush" Color="#442726" />
    <SolidColorBrush x:Key="PmWarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="PmWarningSubtleBrush" Color="#433519" />
    <SolidColorBrush x:Key="PmSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="PmSuccessSubtleBrush" Color="#1E3A1E" />
    <SolidColorBrush x:Key="PmScrimBrush" Color="#99101010" />

    <!-- 控件尺寸 -->
    <sys:Double x:Key="PmControlHeight">32</sys:Double>

    <!-- 布局尺寸必须是 GridLength：RowDefinition.Height / ColumnDefinition.Width 不接受 double -->
    <GridLength x:Key="PmTopBarRowHeight">44</GridLength>
    <GridLength x:Key="PmSidebarColumnWidth">200</GridLength>
    <GridLength x:Key="PmStepBarRowHeight">48</GridLength>

</ResourceDictionary>
