<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        薄封装层（WP2.1）。
        视图只引用这些 Pm* 键，不直接引用任何第三方控件命名空间。
        将来若要换成 WPF-UI，只需替换本文件内各 Style 的 Template 实现，
        视图中的 Style 键名与绑定路径全部不变。
    -->

    <!-- ── 文本 ────────────────────────────────────────────────────────── -->

    <Style x:Key="PmText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PmTitle" TargetType="TextBlock" BasedOn="{StaticResource PmText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PmSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PmText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PmCaption" TargetType="TextBlock" BasedOn="{StaticResource PmText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PmErrorText" TargetType="TextBlock" BasedOn="{StaticResource PmText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PmDangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 行内错误：无错误时自动收起，避免占位导致表单跳动 -->
    <Style x:Key="PmInlineError" TargetType="TextBlock" BasedOn="{StaticResource PmErrorText}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 按钮 ────────────────────────────────────────────────────────── -->

    <Style x:Key="PmButtonBase" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PmControlHeight}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PmPrimaryButton" TargetType="Button" BasedOn="{StaticResource PmButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PmAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="PmSecondaryButton" TargetType="Button" BasedOn="{StaticResource PmButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PmSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PmBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PmGhostButton" TargetType="Button" BasedOn="{StaticResource PmButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="PmDangerButton" TargetType="Button" BasedOn="{StaticResource PmButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PmDangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmAccentTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ── 输入 ────────────────────────────────────────────────────────── -->

    <Style x:Key="PmTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource PmControlHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Background" Value="{DynamicResource PmSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PmBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PmAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PmBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PmSurfaceAltBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PmTextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PmCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                Background="{DynamicResource PmSurfaceBrush}"
                                BorderBrush="{DynamicResource PmBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Width="10"
                                  Height="10"
                                  Data="M 1,5 L 4,8 L 9,2"
                                  Stroke="{DynamicResource PmAccentTextBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PmRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Ring"
                                     Fill="{DynamicResource PmSurfaceBrush}"
                                     Stroke="{DynamicResource PmBorderStrongBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Fill="{DynamicResource PmAccentBrush}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PmAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 容器 ────────────────────────────────────────────────────────── -->
    <Style x:Key="PmCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PmSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PmBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PmListCard" TargetType="Border" BasedOn="{StaticResource PmCard}">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 提示条：Tag 取 Info（默认）/ Warning / Error / Success -->
    <Style x:Key="PmInfoBar" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource PmWarningSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PmWarningBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Error">
                <Setter Property="Background" Value="{DynamicResource PmDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PmDangerBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource PmSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PmSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 模板卡片（单选） ─────────────────────────────────────────────── -->

    <Style x:Key="PmTemplateCard" TargetType="RadioButton">
        <Setter Property="GroupName" Value="PmTemplateGroup" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource PmSurfaceBrush}"
                            BorderBrush="{DynamicResource PmBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 树 / 滚动 ───────────────────────────────────────────────────── -->

    <Style x:Key="PmTreeView" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="PmProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource PmSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
    </Style>

    <Style x:Key="PmSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PmBorderBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ── 列表 ────────────────────────────────────────────────────────── -->

    <Style x:Key="PmListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    </Style>

    <!-- 模板卡片容器（ListBox 单选，选中态即 Step 1 的卡片高亮） -->
    <Style x:Key="PmTemplateCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{DynamicResource PmSurfaceBrush}"
                            BorderBrush="{DynamicResource PmBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PmListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="8,0,8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 图标与导航（M3 / WP3.6）───────────────────────────────────────── -->

    <!--
      图标不引第三方字体包：Windows 10 自带 Segoe MDL2 Assets，Windows 11 自带 Segoe Fluent Icons，
      两者码位基本一致，用逗号做字体回退即可。真缺字体时退化为方块，但每个图标按钮都有 ToolTip 与文字兜底。
    -->
    <FontFamily x:Key="PmIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="PmIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PmIconFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PmIconButton" TargetType="Button" BasedOn="{StaticResource PmGhostButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏导航项：图标 + 文字，选中态用强调色浅底 -->
    <Style x:Key="PmNavItem" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{DynamicResource PmTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PmSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource PmTextDisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PmNavItemActive" TargetType="Button" BasedOn="{StaticResource PmNavItem}">
        <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 搜索框：左侧留出图标位，容器负责画放大镜 -->
    <Style x:Key="PmSearchBox" TargetType="TextBox" BasedOn="{StaticResource PmTextBox}">
        <Setter Property="Padding" Value="30,6,10,6" />
        <Setter Property="Background" Value="{DynamicResource PmSurfaceAltBrush}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- 徽标（模板名 / 外部项目） -->
    <Style x:Key="PmChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 最近项目卡片（UI 方案 6.3：128×88） -->
    <Style x:Key="PmRecentCard" TargetType="Border">
        <Setter Property="Width" Value="128" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource PmSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PmBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PmAccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource PmSurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
