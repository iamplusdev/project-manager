<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 浅色主题令牌。与 Dark.xaml 必须保持完全相同的键集合，否则切换时资源会丢失。 -->

    <SolidColorBrush x:Key="PmBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PmSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PmSurfaceAltBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="PmSurfaceHoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="PmBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="PmBorderStrongBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="PmTextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="PmTextSecondaryBrush" Color="#616161" />
    <SolidColorBrush x:Key="PmTextDisabledBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="PmAccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="PmAccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="PmAccentPressedBrush" Color="#0C3B5E" />
    <SolidColorBrush x:Key="PmAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PmAccentSubtleBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="PmDangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="PmDangerSubtleBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="PmWarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="PmWarningSubtleBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="PmSuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="PmSuccessSubtleBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="PmScrimBrush" Color="#66101010" />

    <!-- 控件尺寸 -->
    <sys:Double x:Key="PmControlHeight">32</sys:Double>

    <!-- 布局尺寸必须是 GridLength：RowDefinition.Height / ColumnDefinition.Width 不接受 double -->
    <GridLength x:Key="PmTopBarRowHeight">44</GridLength>
    <GridLength x:Key="PmSidebarColumnWidth">200</GridLength>
    <GridLength x:Key="PmSidebarCollapsedWidth">48</GridLength>
    <GridLength x:Key="PmStepBarRowHeight">48</GridLength>

</ResourceDictionary>
