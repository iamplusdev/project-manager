<Window x:Class="ProjectManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="540"
        Height="470"
        Background="{StaticResource PmBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <TextBlock Style="{StaticResource PmSectionTitle}" Text="外观" />
                <StackPanel Margin="0,10,0,0">
                    <RadioButton x:Name="ThemeSystemRadio"
                                 Checked="OnThemeChanged"
                                 Content="跟随系统"
                                 GroupName="PmTheme"
                                 Style="{StaticResource PmRadioButton}" />
                    <RadioButton x:Name="ThemeLightRadio"
                                 Checked="OnThemeChanged"
                                 Content="浅色"
                                 GroupName="PmTheme"
                                 Style="{StaticResource PmRadioButton}" />
                    <RadioButton x:Name="ThemeDarkRadio"
                                 Checked="OnThemeChanged"
                                 Content="深色"
                                 GroupName="PmTheme"
                                 Style="{StaticResource PmRadioButton}" />
                </StackPanel>

                <Border Margin="0,14" Style="{StaticResource PmSeparator}" />

                <TextBlock Style="{StaticResource PmSectionTitle}" Text="模板来源" />
                <TextBlock x:Name="TemplateSourceText"
                           Margin="0,8,0,0"
                           Style="{StaticResource PmCaption}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="TemplateWarningText"
                           Margin="0,6,0,0"
                           Style="{StaticResource PmErrorText}" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Click="OnOpenTemplateFolder"
                            Content="打开配置文件夹"
                            Style="{StaticResource PmSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Click="OnReloadTemplates"
                            Content="重新加载模板"
                            Style="{StaticResource PmSecondaryButton}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource PmCaption}"
                           Text="优先级：用户配置 &gt; 安装目录 &gt; 内置默认。修改用户配置文件后需重新加载或重启。" />

                <Border Margin="0,14" Style="{StaticResource PmSeparator}" />

                <TextBlock Style="{StaticResource PmSectionTitle}" Text="生成" />
                <CheckBox x:Name="OpenFolderCheck"
                          Margin="0,10,0,0"
                          Content="生成成功后打开项目目录"
                          Style="{StaticResource PmCheckBox}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource PmSurfaceBrush}"
                BorderBrush="{StaticResource PmBorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Margin="0,0,24,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnClose"
                    Content="关闭"
                    Style="{StaticResource PmPrimaryButton}" />
        </Border>
    </Grid>
</Window>
