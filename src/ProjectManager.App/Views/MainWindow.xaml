<Window x:Class="ProjectManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProjectManager.App.Converters"
        Title="Project_Manager"
        Width="1080"
        Height="700"
        MinWidth="860"
        MinHeight="520"
        Background="{DynamicResource PmBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PathTailConverter x:Key="PathTail" />
        <conv:RelativeTimeConverter x:Key="RelativeTime" />

        <!-- 侧栏折叠时隐藏文字，只留图标 -->
        <Style x:Key="PmNavLabel" TargetType="TextBlock" BasedOn="{StaticResource PmText}">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmNavButton" TargetType="Button" BasedOn="{StaticResource PmNavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmNavButtonActive" TargetType="Button" BasedOn="{StaticResource PmNavButton}">
            <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 导航选中态跟随当前页，而不是写死在 XAML 里 -->
        <Style x:Key="PmNavProjects" TargetType="Button" BasedOn="{StaticResource PmNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProjectsSection}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmNavComponents" TargetType="Button" BasedOn="{StaticResource PmNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComponentsSection}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmNavRepositories" TargetType="Button" BasedOn="{StaticResource PmNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepositoriesSection}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmNavChanges" TargetType="Button" BasedOn="{StaticResource PmNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChangesSection}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PmAccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 仓库清单状态徽标：颜色只表达"要不要处理"，不表达技术分类 -->
        <Style x:Key="PmRepoChip" TargetType="Border" BasedOn="{StaticResource PmChip}">
            <Setter Property="Background" Value="{DynamicResource PmSurfaceAltBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="干净">
                    <Setter Property="Background" Value="{DynamicResource PmSuccessSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="有改动">
                    <Setter Property="Background" Value="{DynamicResource PmWarningSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="不可用">
                    <Setter Property="Background" Value="{DynamicResource PmDangerSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PmRepoChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PmTextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="干净">
                    <Setter Property="Foreground" Value="{DynamicResource PmSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="有改动">
                    <Setter Property="Foreground" Value="{DynamicResource PmWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="不可用">
                    <Setter Property="Foreground" Value="{DynamicResource PmDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource PmTopBarRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 顶栏（44px 单行）：品牌 / 项目切换 / 搜索 / 操作 ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource PmSurfaceBrush}"
                BorderBrush="{DynamicResource PmBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource PmAccentBrush}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PmTextPrimaryBrush}"
                               Text="Project_Manager" />
                </StackPanel>

                <!-- 项目切换 -->
                <Button x:Name="SwitcherButton"
                        Grid.Column="1"
                        Height="30"
                        Margin="20,0,0,0"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Click="OnSwitcherClick"
                        Style="{StaticResource PmGhostButton}"
                        ToolTip="切换当前项目">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock MaxWidth="160"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource PmTextPrimaryBrush}"
                                   Text="{Binding SwitcherLabel}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="6,0,0,0"
                                   Style="{StaticResource PmIcon}"
                                   FontSize="10"
                                   Foreground="{DynamicResource PmTextSecondaryBrush}"
                                   Text="&#xE70D;" />
                    </StackPanel>
                </Button>

                <Popup x:Name="SwitcherPopup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=SwitcherButton}"
                       StaysOpen="False">
                    <Border Width="280"
                            Margin="0,4,0,0"
                            Padding="6"
                            Background="{DynamicResource PmSurfaceBrush}"
                            BorderBrush="{DynamicResource PmBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="6,4,6,6" Style="{StaticResource PmCaption}" Text="项目" />
                            <ListBox x:Name="SwitcherList"
                                     MaxHeight="320"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource PmListBoxItem}"
                                     ItemsSource="{Binding Projects.VisibleProjects}"
                                     SelectionChanged="OnSwitcherSelectionChanged"
                                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     Visibility="{Binding Projects.HasVisibleProjects, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="13"
                                                       Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource PmCaption}"
                                                       Text="{Binding Path, Converter={StaticResource PathTail}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="6,8" Text="清单里还没有项目">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource PmCaption}" TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.HasVisibleProjects}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- 搜索 -->
                <Grid Grid.Column="2"
                      MaxWidth="280"
                      Margin="20,0,12,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PmSearchBox}"
                             Text="{Binding Projects.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或路径过滤（Ctrl+F）" />
                    <TextBlock Margin="10,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource PmTextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Style="{StaticResource PmIcon}"
                               Text="&#xE721;" />
                    <TextBlock Margin="32,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource PmTextDisabledBrush}"
                               IsHitTestVisible="False"
                               Text="搜索项目">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 操作 -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="NewProjectButton"
                            Height="28"
                            Padding="12,0"
                            Click="OnNewProjectClick"
                            Style="{StaticResource PmPrimaryButton}"
                            ToolTip="新建项目 (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PmIcon}" FontSize="12" Text="&#xE710;" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="新建项目" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ThemeButton"
                            Width="32"
                            Height="28"
                            Margin="6,0,0,0"
                            Padding="0"
                            Click="OnThemeToggleClick"
                            Content="&#x25D0;"
                            Style="{StaticResource PmIconButton}"
                            ToolTip="主题：跟随系统（点击切换）" />

                    <Button Width="32"
                            Height="28"
                            Padding="0"
                            Click="OnSettingsClick"
                            Style="{StaticResource PmIconButton}"
                            ToolTip="设置">
                        <TextBlock Style="{StaticResource PmIcon}" Text="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 主体：侧栏 + 主区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="{StaticResource PmSidebarColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PmSurfaceBrush}"
                    BorderBrush="{DynamicResource PmBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 导航六项：项目/组件/仓库/变更已开放；历史/发版按里程碑置灰（UI 方案 §6.3 补注） -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,10,8,6">
                        <Button Click="OnShowProjectsClick" Style="{StaticResource PmNavProjects}" ToolTip="项目">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE8B7;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="项目" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnShowComponentsClick" Style="{StaticResource PmNavComponents}" ToolTip="组件（WP3.1 已开放）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE71D;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="组件" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnShowRepositoriesClick" Style="{StaticResource PmNavRepositories}" ToolTip="仓库清单：跨项目 Git 状态">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE8EF;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="仓库" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnShowChangesClick" Style="{StaticResource PmNavChanges}" ToolTip="变更：待提交改动与差异（WP5.1 / WP5.2）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE8C8;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="变更" />
                            </StackPanel>
                        </Button>
                        <Button IsEnabled="False" Style="{StaticResource PmNavButton}" ToolTip="提交历史（WP5.3 之后开放）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE81C;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="历史" />
                            </StackPanel>
                        </Button>
                        <Button IsEnabled="False" Style="{StaticResource PmNavButton}" ToolTip="发版流水线（M6 起开放）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PmIcon}" Text="&#xE8EC;" />
                                <TextBlock Style="{StaticResource PmNavLabel}" Text="发版" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Margin="12,2,12,2" Style="{StaticResource PmSeparator}" />

                    <!-- 清单头：常驻「打开…」入口（空态消失后仍可达） -->
                    <Grid DockPanel.Dock="Top" Margin="16,8,12,6">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PmCaption}" Text="项目" />
                            <TextBlock Margin="6,0,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding Projects.Count}" />
                        </StackPanel>
                        <Button Height="24"
                                Padding="8,0"
                                HorizontalAlignment="Right"
                                Click="OnOpenExistingClick"
                                Content="打开…"
                                Style="{StaticResource PmSecondaryButton}"
                                ToolTip="把已有目录加入项目清单" />
                    </Grid>

                    <!-- 折叠开关固定在底部 -->
                    <Button DockPanel.Dock="Bottom"
                            Height="30"
                            Margin="8,6,8,8"
                            Padding="0"
                            Click="OnToggleSidebarClick"
                            Style="{StaticResource PmIconButton}"
                            ToolTip="{Binding SidebarToggleHint}">
                        <TextBlock Style="{StaticResource PmIcon}" Text="&#xE700;" />
                    </Button>

                    <ListBox x:Name="ProjectListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource PmListBoxItem}"
                             ItemsSource="{Binding Projects.VisibleProjects}"
                             MouseDoubleClick="OnProjectDoubleClick"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PmTextPrimaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource PmCaption}"
                                               Text="{Binding LastOpenedAt, Converter={StaticResource RelativeTime}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 主区 -->
            <Grid Grid.Column="1">
                <!-- 降级提示（模板加载失败 / 清单损坏） -->
                <Border VerticalAlignment="Top" Margin="24,16,24,0" Tag="Warning">
                    <Border.Style>
                        <Style BasedOn="{StaticResource PmInfoBar}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTemplateWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource PmCaption}" Text="{Binding TemplateWarning}" />
                </Border>

                <!-- ═══ 项目页（三态） ═══ -->
                <Grid Visibility="{Binding IsProjectsSection, Converter={StaticResource BoolToVis}}">

                <!-- ① 空态 -->
                <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource PmTitle}"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource PmCaption}"
                                   Text="{Binding EmptyHint}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Click="OnNewProjectClick"
                                    Content="新建项目"
                                    IsEnabled="{Binding CanScaffold}"
                                    Style="{StaticResource PmPrimaryButton}" />
                            <Button Margin="8,0,0,0"
                                    Click="OnOpenExistingClick"
                                    Content="打开已有项目"
                                    Style="{StaticResource PmSecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ② 最近项目卡片 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="最近项目" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding Projects.Count, StringFormat=共 {0} 个}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource PmCaption}"
                                   Text="点击卡片查看详情，双击列表项在资源管理器中打开。" />
                        <ItemsControl ItemsSource="{Binding Projects.VisibleProjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonUp="OnCardClick" Style="{StaticResource PmRecentCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />

                                            <StackPanel Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource PmCaption}"
                                                           Text="{Binding Path, Converter={StaticResource PathTail}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" />
                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource PmChip}">
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource PmAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TemplateName}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TemplateName}" Value="">
                                                                        <Setter Property="Text" Value="外部项目" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2"
                                                       Style="{StaticResource PmCaption}"
                                                       FontSize="10"
                                                       Text="{Binding LastOpenedAt, Converter={StaticResource RelativeTime}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ③ 项目详情 -->
                <ScrollViewer Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PmTitle}" Text="{Binding SelectedName}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PmCaption}"
                                   Text="{Binding SelectedMeta}" />

                        <Border Margin="0,16,0,0" Style="{StaticResource PmCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PmSectionTitle}" Text="位置" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PmCaption}"
                                           Text="{Binding SelectedPath}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <Button Click="OnOpenFolderClick" Style="{StaticResource PmSecondaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource PmIcon}" FontSize="12" Text="&#xE8E5;" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="在资源管理器中打开" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 模块清单（WP3.3）：来自 .pm-scaffold.json 的生成记录，不猜 -->
                        <Border Margin="0,12,0,0"
                                Style="{StaticResource PmCard}"
                                Visibility="{Binding HasModules, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PmSectionTitle}" Text="模块" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Modules}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" Style="{StaticResource PmChip}">
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource PmAccentBrush}"
                                                           Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource PmCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource PmSectionTitle}" Text="模板同步" />
                                    <Button Height="26"
                                            Padding="10,0"
                                            HorizontalAlignment="Right"
                                            Click="OnApplyUpgradeClick"
                                            Content="补新增目录"
                                            Style="{StaticResource PmSecondaryButton}"
                                            ToolTip="只创建缺失的目录，不删除也不覆盖任何既有文件"
                                            Visibility="{Binding CanApplyUpgrade, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PmCaption}"
                                           Text="{Binding UpgradeSummary}"
                                           TextWrapping="Wrap" />

                                <ItemsControl Margin="0,8,0,0"
                                              ItemsSource="{Binding MissingDirectories}"
                                              Visibility="{Binding HasMissingDirectories, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,1,0,0"
                                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PmTextSecondaryBrush}"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource PmCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PmSectionTitle}" Text="仓库状态" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PmCaption}"
                                           Text="{Binding GitSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource PmCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PmSectionTitle}" Text="待接入" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PmCaption}"
                                           Text="Git 工作台（提交/同步）与发版流水线按里程碑 M3/M4 接入；组件清单已可在侧栏「组件」页查看。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- ═══ 组件页（WP3.1） ═══ -->
                <Grid Visibility="{Binding IsComponentsSection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,20,24,10" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PmSectionTitle}" Text="组件" />
                        <TextBlock Margin="8,0,0,0"
                                   Style="{StaticResource PmCaption}"
                                   Text="{Binding ComponentCountText}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="24,8"
                               Text="{Binding ComponentHint}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource PmCaption}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasComponents}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasComponents, Converter={StaticResource BoolToVis}}">
                        <ItemsControl Margin="24,0,24,20" ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource PmCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Style="{StaticResource PmCaption}"
                                                           Text="{Binding RelativePath}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource PmCaption}"
                                                           Text="{Binding MarkerFile}" />
                                                <Border Style="{StaticResource PmChip}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource PmAccentBrush}"
                                                               Text="{Binding Kind}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ 仓库页（G3：跨项目仓库清单） ═══ -->
                <Grid Visibility="{Binding IsRepositoriesSection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20,24,10">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="仓库" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding RepositoryStatsText}" />
                        </StackPanel>
                        <Button Height="26"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                Click="OnRefreshRepositoriesClick"
                                Content="刷新"
                                Style="{StaticResource PmSecondaryButton}"
                                ToolTip="重新查询每个项目的 Git 状态（不读缓存）" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="24,8"
                               Text="{Binding RepositoryHint}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource PmCaption}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRepositories}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRepositories, Converter={StaticResource BoolToVis}}">
                        <ItemsControl Margin="24,0,24,20" ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Style="{StaticResource PmCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                               Text="{Binding Name}" />
                                                    <Border Margin="8,0,0,0" Style="{StaticResource PmRepoChip}">
                                                        <TextBlock Style="{StaticResource PmRepoChipText}" Text="{Binding StatusText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource PmCaption}">
                                                    <Run Text="{Binding FolderName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding DetailText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Height="24"
                                                    Padding="10,0"
                                                    VerticalAlignment="Center"
                                                    Click="OnOpenRepositoryProjectClick"
                                                    Content="查看"
                                                    Style="{StaticResource PmSecondaryButton}"
                                                    ToolTip="在项目页打开这个项目" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ 变更页（M5 · WP5.1 / WP5.2：Git 工作台） ═══ -->
                <Grid Visibility="{Binding IsChangesSection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 页头 -->
                    <Grid Grid.Row="0" Margin="24,20,24,10">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="变更" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding ChangesSummary}" />
                        </StackPanel>
                        <Button Height="26"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                Click="OnRefreshChangesClick"
                                Content="刷新"
                                Style="{StaticResource PmSecondaryButton}"
                                ToolTip="重新读取工作区（不读缓存）" />
                    </Grid>

                    <!-- 主体：左清单 / 右差异 -->
                    <Grid Grid.Row="1" Margin="24,0,24,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="264" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 变更清单 -->
                        <Border Grid.Column="0" Style="{StaticResource PmCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="12,10,12,6"
                                           Style="{StaticResource PmCaption}"
                                           Text="勾选后可暂存到索引区" />

                                <TextBlock DockPanel.Dock="Top"
                                           Margin="12,4,12,8"
                                           Text="{Binding ChangesHint}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PmCaption}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox Margin="4,0,4,6"
                                         ItemsSource="{Binding ChangeItems}"
                                         SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                                         Style="{StaticResource PmListBox}"
                                         Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource PmCheckBox}"
                                                          ToolTip="只表示勾选，不写入索引；点下方「暂存所选」才生效" />

                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                               Text="{Binding DisplayPath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayPath}" />
                                                    <TextBlock Style="{StaticResource PmCaption}" Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 差异预览 -->
                        <Border Grid.Column="2" Style="{StaticResource PmCard}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PmTextPrimaryBrush}"
                                               Text="{Binding DiffTitle}"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource PmCaption}"
                                               Text="{Binding DiffStat}" />
                                </Grid>

                                <Border DockPanel.Dock="Top" Margin="12,0,12,6" Style="{StaticResource PmSeparator}" />

                                <TextBlock Margin="12,10,12,10"
                                           Text="{Binding DiffHint}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasDiffHint, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PmCaption}" TargetType="TextBlock" />
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 单文件 diff：未做虚拟化，横向可滚（代码行不该软换行，否则行号列会错位） -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasDiffRows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding DiffRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowBackground" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Margin="0,0,6,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource PmTextSecondaryBrush}"
                                                                   Text="{Binding OldNumber}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="0,0,6,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource PmTextSecondaryBrush}"
                                                                   Text="{Binding NewNumber}" />
                                                        <TextBlock Grid.Column="2"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PmTextSecondaryBrush}"
                                                                   Text="{Binding Marker}" />
                                                        <TextBlock x:Name="RowText"
                                                                   Grid.Column="3"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PmTextPrimaryBrush}"
                                                                   Text="{Binding Text}"
                                                                   TextWrapping="NoWrap" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- 增绿删红：这是代码差异的国际惯例，不是行情的涨跌色 -->
                                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                        <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource PmSuccessSubtleBrush}" />
                                                        <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource PmSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                        <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource PmDangerSubtleBrush}" />
                                                        <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource PmDangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource PmAccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                        <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource PmTextSecondaryBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 提交区 -->
                    <Border Grid.Row="2"
                            Margin="24,0,24,20"
                            Padding="16,12"
                            Style="{StaticResource PmCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PmCaption}" Text="提交标题" />
                                <TextBox x:Name="CommitTitleBox"
                                         MinHeight="30"
                                         Text="{Binding CommitTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PmTextBox}"
                                         ToolTip="一句话说明这次改了什么（first line 会成为提交摘要）" />

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource PmCaption}" Text="描述（可选）" />
                                <TextBox Height="52"
                                         AcceptsReturn="True"
                                         Text="{Binding CommitBody, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource PmTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Height="30"
                                        Padding="12,0"
                                        Click="OnStageSelectedClick"
                                        Content="暂存所选"
                                        Style="{StaticResource PmSecondaryButton}"
                                        ToolTip="把勾选的文件加入索引区（git add）" />
                                <Button Height="30"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="OnUnstageSelectedClick"
                                        Content="取消暂存"
                                        Style="{StaticResource PmSecondaryButton}"
                                        ToolTip="把勾选的文件移出索引区，工作区内容不变（git reset）" />
                                <Button Height="30"
                                        Margin="8,0,0,0"
                                        Padding="16,0"
                                        Click="OnCommitClick"
                                        Content="提交"
                                        IsEnabled="{Binding CanCommit}"
                                        Style="{StaticResource PmPrimaryButton}"
                                        ToolTip="提交索引区内容（经 Git CLI，仓库 hooks 会正常执行）" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Margin="0,0,0,4"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding CommitHint}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ 非阻塞提示（UI 方案第 4 节：SnackBar） ═══ -->
        <Border x:Name="SnackHost"
                Grid.Row="1"
                Padding="14,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource PmTextPrimaryBrush}"
                CornerRadius="6"
                Opacity="0"
                Visibility="Collapsed">
            <!-- 变更页底部有提交区：提示浮在原位会正好盖住「提交」按钮，所以在那一页抬高 -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,24,24" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChangesSection}" Value="True">
                            <Setter Property="Margin" Value="0,0,24,152" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.22" ShadowDepth="2" />
            </Border.Effect>
            <TextBlock x:Name="SnackText"
                       MaxWidth="420"
                       FontSize="13"
                       Foreground="{DynamicResource PmSurfaceBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
