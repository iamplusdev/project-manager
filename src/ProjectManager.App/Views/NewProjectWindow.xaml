<Window x:Class="ProjectManager.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wiz="clr-namespace:ProjectManager.Application.Wizard;assembly=ProjectManager.Application"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="660"
        MinWidth="820"
        MinHeight="600"
        Background="{StaticResource PmBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 预览树节点：符号 + 名称 + 文字状态标签（状态不只用颜色传达） -->
        <HierarchicalDataTemplate x:Key="PreviewNodeTemplate"
                                  DataType="{x:Type wiz:PreviewNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="16"
                           Foreground="{StaticResource PmTextSecondaryBrush}"
                           Text="{Binding StatusGlyph}" />
                <TextBlock Text="{Binding Name}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource PmText}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Backup">
                                    <Setter Property="Foreground" Value="{StaticResource PmWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Preserve">
                                    <Setter Property="Foreground" Value="{StaticResource PmTextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Ignored">
                                    <Setter Property="Foreground" Value="{StaticResource PmTextDisabledBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skip">
                                    <Setter Property="Foreground" Value="{StaticResource PmTextDisabledBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="8,0,0,0"
                           Style="{StaticResource PmCaption}"
                           Text="{Binding StatusLabel}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource PmStepBarRowHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- 步骤条（48px，自绘） -->
        <Border Grid.Row="0"
                Background="{StaticResource PmSurfaceBrush}"
                BorderBrush="{StaticResource PmBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="Dot1" StrokeThickness="1" />
                        <TextBlock x:Name="Num1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="Label1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource PmCaption}"
                               Text="基本信息" />
                </StackPanel>

                <Border Grid.Column="1" Height="1" Margin="12,0" VerticalAlignment="Center" Background="{StaticResource PmBorderBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="Dot2" StrokeThickness="1" />
                        <TextBlock x:Name="Num2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="Label2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource PmCaption}"
                               Text="模板与模块" />
                </StackPanel>

                <Border Grid.Column="3" Height="1" Margin="12,0" VerticalAlignment="Center" Background="{StaticResource PmBorderBrush}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="Dot3" StrokeThickness="1" />
                        <TextBlock x:Name="Num3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="Label3"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource PmCaption}"
                               Text="预览确认" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1">

            <!-- 生成进度（不确定进度，覆盖在顶部） -->
            <ProgressBar VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Style="{StaticResource PmProgressBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- Step 1 · 基本信息 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsBasicStep, Converter={StaticResource BoolToVis}}">
                <StackPanel Width="620" Margin="28,22" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PmSectionTitle}" Text="项目名称 *" />
                    <TextBox Margin="0,6,0,0"
                             MaxLength="80"
                             Style="{StaticResource PmTextBox}"
                             Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource PmInlineError}" Text="{Binding NameError}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource PmSectionTitle}" Text="项目简介 *" />
                    <TextBox Height="64"
                             Margin="0,6,0,0"
                             MaxLength="260"
                             AcceptsReturn="True"
                             Style="{StaticResource PmTextBox}"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />
                    <TextBlock Style="{StaticResource PmInlineError}" Text="{Binding DescriptionError}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource PmSectionTitle}" Text="生成位置 *" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource PmTextBox}"
                                 Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="OnBrowseClick"
                                Content="浏览…"
                                Style="{StaticResource PmSecondaryButton}" />
                    </Grid>
                    <TextBlock Style="{StaticResource PmInlineError}" Text="{Binding PathError}" />

                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource PmCaption}"
                               Text="项目将创建在该目录下的同名子文件夹中。若同名目录已存在，下一步会提示合并或仅预览。" />
                </StackPanel>
            </ScrollViewer>

            <!-- Step 2 · 模板与模块 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsTemplateStep, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,20">
                    <TextBlock Style="{StaticResource PmSectionTitle}" Text="选择模板" />
                    <ListBox Height="132"
                             Margin="0,8,0,0"
                             ItemContainerStyle="{StaticResource PmTemplateCardItem}"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             Style="{StaticResource PmListBox}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PmTextPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource PmAccentBrush}"
                                                CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource PmAccentTextBrush}"
                                                       Text="推荐" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource PmCaption}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="包含模块" />
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding ModuleHint}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Click="OnSelectAllModules"
                                    Content="全选"
                                    Style="{StaticResource PmGhostButton}" />
                            <Button Click="OnInvertModules"
                                    Content="反选"
                                    Style="{StaticResource PmGhostButton}" />
                            <Button Click="OnClearModules"
                                    Content="清空"
                                    Style="{StaticResource PmGhostButton}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,24,10"
                                          Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource PmCheckBox}"
                                          ToolTip="{Binding PathsSummary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,8,0,0" Padding="14" Style="{StaticResource PmCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="派生标识（只读）" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="由项目名按固定规则派生，供工程文件与包名使用；不可单独编辑，避免各处不一致。" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource PmCaption}" Text="根命名空间" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource PmText}"
                                           Text="{Binding Derived.NamespaceText}" />
                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource PmCaption}" Text="包名 / 标识" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource PmText}"
                                           Text="{Binding Derived.PackageText}" />
                                <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource PmCaption}" Text="目录名参考" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource PmText}"
                                           Text="{Binding Derived.DirectoryText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 3 · 预览与确认 -->
            <Grid Margin="20,14"
                  Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="8,0,8,0" Style="{StaticResource PmCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource PmSectionTitle}"
                                   Text="目录预览" />
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,4,0,8"
                                   Style="{StaticResource PmCaption}"
                                   Text="符号：+ 将创建　↺ 将备份　· 保留　— 已忽略　= 已存在" />
                        <TreeView ItemTemplate="{StaticResource PreviewNodeTemplate}"
                                  ItemsSource="{Binding PreviewRoots}"
                                  Style="{StaticResource PmTreeView}" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource PmCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="本次变更" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource PmText}"
                                       Text="{Binding SummaryCreateText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding SummaryBackupText}" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="{Binding SummaryPreserveText}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,8,0,0" Tag="Warning">
                        <Border.Style>
                            <Style BasedOn="{StaticResource PmInfoBar}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTargetExisted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource PmCaption}"
                                   Text="目标目录已存在：本次生成会且只会合并，不删除任何既有内容。" />
                    </Border>

                    <Border Margin="0,8,0,0" Tag="Error">
                        <Border.Style>
                            <Style BasedOn="{StaticResource PmInfoBar}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPreviewWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource PmCaption}" Text="{Binding PreviewWarning}" />
                    </Border>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource PmSectionTitle}" Text="执行方式" />
                    <StackPanel Margin="0,8,0,0">
                        <RadioButton Content="合并生成（推荐）"
                                     GroupName="Strategy"
                                     IsChecked="{Binding IsMergeStrategy, Mode=TwoWay}"
                                     Style="{StaticResource PmRadioButton}" />
                        <RadioButton Content="仅预览（不写入任何文件）"
                                     GroupName="Strategy"
                                     IsChecked="{Binding IsPreviewOnlyStrategy, Mode=TwoWay}"
                                     Style="{StaticResource PmRadioButton}" />
                    </StackPanel>

                    <CheckBox Margin="0,8,0,0"
                              Content="生成后初始化 Git 仓库"
                              IsChecked="{Binding InitGit, Mode=TwoWay}"
                              Style="{StaticResource PmCheckBox}" />
                </StackPanel>
            </Grid>

            <!-- 结果页 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsResultStep, Converter={StaticResource BoolToVis}}">
                <StackPanel Width="560" Margin="0,40,0,0" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource PmTitle}"
                               Text="{Binding Outcome.Headline}" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource PmCaption}"
                               Text="{Binding Outcome.ProjectPath}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Border Margin="0,20,0,0">
                        <Border.Style>
                            <Style BasedOn="{StaticResource PmCard}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResultStats}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PmSectionTitle}" Text="本次变更" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource PmText}"
                                       Text="{Binding ResultSummary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PmCaption}"
                                       Text="该项目已在项目清单中，主壳左侧可见。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Tag="Warning">
                        <Border.Style>
                            <Style BasedOn="{StaticResource PmInfoBar}" TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOutcomeWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource PmCaption}"
                                   Text="{Binding OutcomeWarning}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Click="OnOpenResultFolder"
                                Content="打开目录"
                                Style="{StaticResource PmPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Click="OnCopyPath"
                                Content="复制路径"
                                Style="{StaticResource PmSecondaryButton}" />
                        <Button Margin="8,0,0,0"
                                Click="OnRetryRegistration"
                                Content="重试注册"
                                Style="{StaticResource PmSecondaryButton}"
                                Visibility="{Binding CanRetryRegistration, Converter={StaticResource BoolToVis}}" />
                        <Button Margin="8,0,0,0"
                                Click="OnFinish"
                                Content="完成"
                                Style="{StaticResource PmSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource PmSurfaceBrush}"
                BorderBrush="{StaticResource PmBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource PmCaption}"
                           Text="{Binding FooterHint}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnCancel"
                            Content="取消"
                            Style="{StaticResource PmGhostButton}"
                            Visibility="{Binding IsNotResultStep, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="8,0,0,0"
                            Click="OnBack"
                            Content="上一步"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource PmSecondaryButton}"
                            Visibility="{Binding IsNotResultStep, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="8,0,0,0"
                            Click="OnNext"
                            Content="下一步"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource PmPrimaryButton}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="8,0,0,0"
                            Click="OnGenerate"
                            Content="生成"
                            IsEnabled="{Binding CanGenerate}"
                            Style="{StaticResource PmPrimaryButton}"
                            Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="8,0,0,0"
                            Click="OnFinish"
                            Content="完成"
                            Style="{StaticResource PmPrimaryButton}"
                            Visibility="{Binding IsResultStep, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
