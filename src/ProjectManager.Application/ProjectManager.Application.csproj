<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ProjectManager.Application</RootNamespace>
    <AssemblyName>ProjectManager.Application</AssemblyName>
    <Version>0.2.0</Version>
    <Description>应用编排层：向导状态机、生成协调、项目注册。零 WPF 依赖，可无界面单测。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectManager.Scaffolding\ProjectManager.Scaffolding.csproj" />
    <ProjectReference Include="..\ProjectManager.Storage\ProjectManager.Storage.csproj" />
    <ProjectReference Include="..\ProjectManager.CliInterop\ProjectManager.CliInterop.csproj" />
  </ItemGroup>

</Project>
